# Copy to .env and fill in what you have. .env is git-ignored. Every key is optional;
# the application works with none of them (classical extraction, local data, in-memory graph).

# Live job feeds
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional skill taxonomy (not required — O*NET is the default)
LIGHTCAST_CLIENT_ID=
LIGHTCAST_CLIENT_SECRET=

# Hosted LLMs (never receive resume text unless privacy.allow_remote_pii is true)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional proprietary baseline via any OpenAI-compatible endpoint (RQ1)
PROPRIETARY_BASE_URL=
PROPRIETARY_API_KEY=

# Knowledge graph (falls back to an in-memory graph if unset/unreachable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434

# Application
# development | full
APP_MODE=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:8501
BACKEND_URL=http://localhost:8000
